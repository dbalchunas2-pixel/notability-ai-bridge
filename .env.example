# Notability AI Bridge - environment configuration
# Copy this file and fill in your values. Never commit real secrets.

# --- Google Cloud OAuth (required) ---
# From Google Cloud Console > Credentials > OAuth client ID (Web application).
# The authorized redirect URI must be YOUR_BASE_URL/auth/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# --- URLs (required) ---
# For local development:
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
BASE_URL=http://localhost:8080
# For Railway: https://your-app.up.railway.app/auth/callback and
#              https://your-app.up.railway.app

# --- Server (optional) ---
PORT=8080
# Where SQLite stores users/keys/usage. On Railway, mount a volume at /data
DATA_DIR=/data
